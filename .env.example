APP_HOST=127.0.0.1
APP_PORT=8765
# 根路径以 / 表示，运行时归一为空前缀
APP_ROOT_PATH=/
CDP_URL=http://127.0.0.1:9222
ASR_PYTHON=.venvs/asr/bin/python
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
DATA_DIR=.local
CHUNK_SECONDS=30
MAX_ROOMS=10
QUEUE_SIZE=20
SILENCE_DBFS=-55
VAD_ENABLED=1
# Silero v5 ONNX模型；缺失时显示VAD错误并降级为原音频识别
VAD_MODEL_PATH=.local/models/silero_vad.onnx
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_SECONDS=0.3
MAX_RECONNECTS=5
RETRY_DELAY=2
HF_HUB_OFFLINE=0
